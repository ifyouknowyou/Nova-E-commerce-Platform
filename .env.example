# ────────────────────────────────────────────────────────────────
# NOVA COMMERCE — root environment (infrastructure / docker-compose)
# Copy to .env and adjust. Never commit real secrets.
# ────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_dev_password
POSTGRES_DB=nova_commerce
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=nova_minio
MINIO_ROOT_PASSWORD=nova_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

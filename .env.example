# ────────────────────────────────────────────────────────────────
# NOVA COMMERCE — Environment Variables
# Copy to .env (local) and set individually in Render dashboard.
# Never commit real secrets.
# ────────────────────────────────────────────────────────────────

# ── JWT ──────────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_SESSION_TTL=30d

# ── API (NestJS) ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated allowed origins (browser → API).
# For single-domain Render deploy set this to your production URL.
CORS_ORIGIN=http://localhost:3000,http://localhost:4000
# Public-facing URLs (used in email templates, OAuth callbacks, etc.)
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000/api

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://nova:nova@localhost:5432/nova_commerce

# ── Redis (optional — cache/sessions/queues) ────────────────────
# Leave empty to run without Redis (cache features disabled gracefully).
REDIS_URL=

# ── Google OAuth ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Email (Resend) ──────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=NOVA Commerce <no-reply@nova.local>

# ── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook URL for single-domain deploy:
# https://yourdomain.com/api/payments/webhook
STRIPE_WEBHOOK_URL=

# ── Object Storage (S3-compatible) ──────────────────────────────
# Local dev: MinIO on localhost:9000
# Prod (Render): use AWS S3, DigitalOcean Spaces, etc.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nova-media
S3_ACCESS_KEY=nova_minio
S3_SECRET_KEY=nova_minio_password
S3_FORCE_PATH_STYLE=true

# ── Web (Next.js) ───────────────────────────────────────────────
# Public site URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public API base (browser → API).
# For single-domain Render deploy set to "/api".
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Internal API base (server → API, used in RSC / server components).
# For single-domain Render deploy set to "http://nova-api:4000".
API_INTERNAL_URL=http://localhost:4000/api
# Stripe publishable key (client-side only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

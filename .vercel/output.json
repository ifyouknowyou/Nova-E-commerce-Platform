{
  "version": 3,
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server/$1"
    }
  ],
  "images": {
    "sizes": [16, 32, 48, 64, 96, 128, 256, 384],
    "domains": [],
    "minimumCacheTTL": 60,
    "formats": ["image/webp"],
    "dangerouslyAllowSVG": false,
    "contentSecurityPolicy": "script-src 'none'; frame-src 'none'; sandbox;"
  }
}

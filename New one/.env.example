# ────────────────────────────────────────────────────────────────
# NEXUS OS — root environment. Copy to .env and adjust.
# Never commit real secrets.
# ────────────────────────────────────────────────────────────────

# PostgreSQL (docker-compose maps host 5433 -> container 5432 to avoid
# colliding with the NOVA stack already bound to 5432).
POSTGRES_PASSWORD=nexus_dev_password
DB_PORT=5433

# Runtime connection — the API connects as nexus_app, which is subject to RLS.
DATABASE_URL="postgresql://nexus_app:nexus_dev_password@localhost:5433/nexus_os?schema=public"

# Migration/seed connection — nexus_migrate bypasses RLS so it can create
# policies and seed cross-tenant data.
DATABASE_MIGRATE_URL="postgresql://nexus_migrate:nexus_dev_password@localhost:5433/nexus_os?schema=public"

# Auth (Phase 2 wire-up; required by the bootstrap so the API boots clean).
JWT_SECRET="generate-with: openssl rand -hex 64"
JWT_EXPIRES_IN="15m"

# API
API_PORT=4000
API_GLOBAL_PREFIX="api"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Node
NODE_ENV=development
# ────────────────────────────────────────────────────────────────
# Phase 6 — AI layer
# ────────────────────────────────────────────────────────────────
# Optional. When unset, the Copilot/Agents use the deterministic local
# engine (answers from real tenant data, never canned). Set it to enable
# Claude-backed answers.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"
# Auto-deny pending approvals that are unresolved for this long (ms).
AI_APPROVAL_TTL_MS="86400000"

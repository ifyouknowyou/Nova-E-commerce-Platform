{
  "name": "@nexus/api",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS OS — NestJS REST API (OpenAPI as the source of truth).",
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",

{
  "name": "@nexus/web",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS OS — Next.js web shell (Phase-2 surface; Phase 1 holds generated API types).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint \"src/**/*\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:types": "openapi-typescript http://localhost:4000/docs-json -o src/lib/api/generated.ts",
    "test": "echo \"@nexus/web: no unit tests\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@nexus/config": "*",
    "@nexus/shared": "*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.0",
    "openapi-typescript": "^7.6.0",
    "typescript": "^5.7.3"
  }
}

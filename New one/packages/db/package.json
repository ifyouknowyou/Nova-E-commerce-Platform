{
  "name": "@nexus/db",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS OS — Prisma schema, RLS migration, seed, and runtime client.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "echo \"@nexus/db: skip lint\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@nexus/config": "*",
    "@nexus/shared": "*",
    "@types/node": "^24.0.0",
    "prisma": "^6.10.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  }
}
// NEXUS OS — Prisma schema (Phase 1: Foundation & Architecture).
//
// Multi-tenancy (upgrade Decision 1): every tenant-scoped table carries `orgId`
// and is guarded by a Postgres RLS policy `org_id = current_setting('app.org')`.
//   * Platform (no RLS): User, Organization. These carry no tenant data.
//   * Tenant-scoped (RLS on orgId): everything layered under an Organization.
//
// Runtime access is via the `nexus_app` role (NOBYPASSRLS); migrations/seeds use
// `nexus_migrate` (BYPASSRLS) through a separate URL (prisma.config.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")          // runtime: nexus_app (RLS-applied)
  directUrl    = env("DATABASE_MIGRATE_URL")  // CLI: nexus_migrate (BYPASSRLS)
  relationMode = "prisma"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

// Mirrors @nexus/shared ROLE_CODES.
enum RoleCode {
  OWNER
  ADMIN
  MANAGER
  SALES
  FINANCE
  OPERATIONS
  HR
  SUPPORT
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
  EXECUTE
  MANAGE
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum SettingScope {
  ORGANIZATION
  PERSONAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  EXPORT
  EXECUTE
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITE_ACCEPT
}

enum SecurityEventType {
  SIGNUP
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_VERIFIED
  SESSION_REVOKED
  INVITE_SENT
  INVITE_ACCEPTED
  ORG_SWITCHED
  INTEGRATION_TESTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum IntegrationProvider {
  WEBHOOK
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform tables (non-tenant; no RLS on these)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String?
  avatarUrl       String?   @map("avatar_url")
  passwordHash    String?   @map("password_hash")
  status          String    @default("ACTIVE")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships        OrganizationMember[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  securityEvents     SecurityEvent[]
  preferences        UserPreference[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  plan      String   @default("starter")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     OrganizationMember[]
  roles       Role[]
  settings    Setting[]
  invitations Invitation[]
  integrations Integration[]

  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant-scoped tables — EACH carries orgId + an RLS policy (01_init.sql)
// ─────────────────────────────────────────────────────────────────────────────

model OrganizationMember {
  id        String         @id @default(uuid()) @db.Uuid
  orgId     String         @map("org_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  status    MemberStatus   @default(INVITED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id])
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]

  @@unique([orgId, userId])
  @@index([orgId])
  @@map("organization_members")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  code        RoleCode
  name        String
  description String?
  isSystem    Boolean      @default(false) @map("is_system")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id])
  permissions  RolePermission[]
  memberships  MembershipRole[]

  @@unique([orgId, code])
  @@index([orgId])
  @@map("roles")
}

// Global RBAC catalogue. Same codes every org sees; not tenant-isolated, but
// only OWNER/ADMIN may mutate it (guard-level, not row-level).
model Permission {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique
  entity      String
  action      PermissionAction
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model MembershipRole {
  id       String @id @default(uuid()) @db.Uuid
  memberId String @map("member_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  member OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
  @@index([memberId])
  @@map("membership_roles")
}

model Session {
  id        String        @id @default(uuid()) @db.Uuid
  orgId     String        @map("org_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  status    SessionStatus @default(ACTIVE)
  ip        String?
  userAgent String?       @map("user_agent")
  expiresAt DateTime      @map("expires_at")
  createdAt DateTime      @default(now())
  revokedAt DateTime?     @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId])
  @@index([orgId])
  @@map("sessions")
}

model Setting {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  key       String
  value     Json
  scope     SettingScope @default(ORGANIZATION)
  updatedAt DateTime     @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, key])
  @@index([orgId])
  @@map("settings")
}

model AuditLog {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  actorId   String?      @map("actor_id") @db.Uuid
  action    AuditAction
  entity    String
  entityId  String       @map("entity_id")
  meta      Json?
  ip        String?
  userAgent String?      @map("user_agent")
  createdAt DateTime     @default(now())

  @@index([orgId, entity, entityId])
  @@index([orgId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  orgId     String           @map("org_id") @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now())

  @@index([orgId, userId])
  @@map("notifications")
}

model ApiKeyRecord {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @map("org_id") @db.Uuid
  name       String
  keyHash    String       @map("key_hash") @unique
  status     ApiKeyStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?    @map("last_used_at")

  @@index([orgId])
  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2: verification tokens (user-scoped, RLS on app.user_id)
// ─────────────────────────────────────────────────────────────────────────────

model VerificationToken {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  type      VerificationTokenType
  tokenHash String               @map("token_hash") @unique
  expiresAt DateTime             @map("expires_at")
  usedAt    DateTime?            @map("used_at")
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

// Personal preferences — user-scoped (RLS on app.user_id), key/value Json.
model UserPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("user_preferences")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2: tenant-scoped — security events, invitations, integrations (RLS)
// ─────────────────────────────────────────────────────────────────────────────

model SecurityEvent {
  id        String           @id @default(uuid()) @db.Uuid
  orgId     String           @map("org_id") @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  type      SecurityEventType
  ip        String?
  userAgent String?          @map("user_agent")
  meta      Json?
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, userId])
  @@map("security_events")
}

model Invitation {
  id           String          @id @default(uuid()) @db.Uuid
  orgId        String          @map("org_id") @db.Uuid
  email        String
  roleCode     RoleCode        @map("role_code")
  tokenHash    String          @map("token_hash") @unique
  status       InvitationStatus @default(PENDING)
  invitedById  String?         @map("invited_by_id") @db.Uuid
  acceptedById String?         @map("accepted_by_id") @db.Uuid
  expiresAt    DateTime        @map("expires_at")
  acceptedAt   DateTime?       @map("accepted_at")
  createdAt    DateTime        @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, email])
  @@index([orgId])
  @@map("invitations")
}

model Integration {
  id           String            @id @default(uuid()) @db.Uuid
  orgId        String            @map("org_id") @db.Uuid
  provider     IntegrationProvider
  name         String
  config       Json
  status       IntegrationStatus @default(DISCONNECTED)
  enabled      Boolean           @default(true)
  lastTestedAt DateTime?         @map("last_tested_at")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("integrations")
}
// NEXUS OS — Prisma schema (Phase 1: Foundation & Architecture).
//
// Multi-tenancy (upgrade Decision 1): every tenant-scoped table carries `orgId`
// and is guarded by a Postgres RLS policy `org_id = current_setting('app.org')`.
//   * Platform (no RLS): User, Organization. These carry no tenant data.
//   * Tenant-scoped (RLS on orgId): everything layered under an Organization.
//
// Runtime access is via the `nexus_app` role (NOBYPASSRLS); migrations/seeds use
// `nexus_migrate` (BYPASSRLS) through a separate URL (prisma.config.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")          // runtime: nexus_app (RLS-applied)
  directUrl    = env("DATABASE_MIGRATE_URL")  // CLI: nexus_migrate (BYPASSRLS)
  relationMode = "prisma"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

// Mirrors @nexus/shared ROLE_CODES.
enum RoleCode {
  OWNER
  ADMIN
  MANAGER
  SALES
  FINANCE
  OPERATIONS
  HR
  SUPPORT
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
  EXECUTE
  MANAGE
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum SettingScope {
  ORGANIZATION
  PERSONAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  EXPORT
  EXECUTE
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITE_ACCEPT
}

enum SecurityEventType {
  SIGNUP
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET
  EMAIL_VERIFIED
  SESSION_REVOKED
  INVITE_SENT
  INVITE_ACCEPTED
  ORG_SWITCHED
  INTEGRATION_TESTED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum IntegrationProvider {
  WEBHOOK
}

enum IntegrationStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

// ─── Phase 3: business-module enums ─────────────────────────────

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum DealStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  TASK
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  OTHER
}

// ─── Phase 4: ops/support enums ────────────────────────────────

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  TRANSFER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

// ─────────────────────────────────────────────────────────────────────────────
// Platform tables (non-tenant; no RLS on these)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String?
  avatarUrl       String?   @map("avatar_url")
  passwordHash    String?   @map("password_hash")
  status          String    @default("ACTIVE")
  emailVerifiedAt DateTime? @map("email_verified_at")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships        OrganizationMember[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  securityEvents     SecurityEvent[]
  preferences        UserPreference[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  plan      String   @default("starter")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     OrganizationMember[]
  roles       Role[]
  settings    Setting[]
  invitations Invitation[]
  integrations Integration[]

  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant-scoped tables — EACH carries orgId + an RLS policy (01_init.sql)
// ─────────────────────────────────────────────────────────────────────────────

model OrganizationMember {
  id        String         @id @default(uuid()) @db.Uuid
  orgId     String         @map("org_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  status    MemberStatus   @default(INVITED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id])
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        MembershipRole[]

  @@unique([orgId, userId])
  @@index([orgId])
  @@map("organization_members")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  code        RoleCode
  name        String
  description String?
  isSystem    Boolean      @default(false) @map("is_system")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organization Organization      @relation(fields: [orgId], references: [id])
  permissions  RolePermission[]
  memberships  MembershipRole[]

  @@unique([orgId, code])
  @@index([orgId])
  @@map("roles")
}

// Global RBAC catalogue. Same codes every org sees; not tenant-isolated, but
// only OWNER/ADMIN may mutate it (guard-level, not row-level).
model Permission {
  id          String            @id @default(uuid()) @db.Uuid
  code        String            @unique
  entity      String
  action      PermissionAction
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model MembershipRole {
  id       String @id @default(uuid()) @db.Uuid
  memberId String @map("member_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid

  member OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
  @@index([memberId])
  @@map("membership_roles")
}

model Session {
  id        String        @id @default(uuid()) @db.Uuid
  orgId     String        @map("org_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  status    SessionStatus @default(ACTIVE)
  ip        String?
  userAgent String?       @map("user_agent")
  expiresAt DateTime      @map("expires_at")
  createdAt DateTime      @default(now())
  revokedAt DateTime?     @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId])
  @@index([orgId])
  @@map("sessions")
}

model Setting {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  key       String
  value     Json
  scope     SettingScope @default(ORGANIZATION)
  updatedAt DateTime     @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, key])
  @@index([orgId])
  @@map("settings")
}

model AuditLog {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  actorId   String?      @map("actor_id") @db.Uuid
  action    AuditAction
  entity    String
  entityId  String       @map("entity_id")
  meta      Json?
  ip        String?
  userAgent String?      @map("user_agent")
  createdAt DateTime     @default(now())

  @@index([orgId, entity, entityId])
  @@index([orgId, createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  orgId     String           @map("org_id") @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now())

  @@index([orgId, userId])
  @@map("notifications")
}

model ApiKeyRecord {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @map("org_id") @db.Uuid
  name       String
  keyHash    String       @map("key_hash") @unique
  status     ApiKeyStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  lastUsedAt DateTime?    @map("last_used_at")

  @@index([orgId])
  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2: verification tokens (user-scoped, RLS on app.user_id)
// ─────────────────────────────────────────────────────────────────────────────

model VerificationToken {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  type      VerificationTokenType
  tokenHash String               @map("token_hash") @unique
  expiresAt DateTime             @map("expires_at")
  usedAt    DateTime?            @map("used_at")
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

// Personal preferences — user-scoped (RLS on app.user_id), key/value Json.
model UserPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("user_preferences")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2: tenant-scoped — security events, invitations, integrations (RLS)
// ─────────────────────────────────────────────────────────────────────────────

model SecurityEvent {
  id        String           @id @default(uuid()) @db.Uuid
  orgId     String           @map("org_id") @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  type      SecurityEventType
  ip        String?
  userAgent String?          @map("user_agent")
  meta      Json?
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([orgId, userId])
  @@map("security_events")
}

model Invitation {
  id           String          @id @default(uuid()) @db.Uuid
  orgId        String          @map("org_id") @db.Uuid
  email        String
  roleCode     RoleCode        @map("role_code")
  tokenHash    String          @map("token_hash") @unique
  status       InvitationStatus @default(PENDING)
  invitedById  String?         @map("invited_by_id") @db.Uuid
  acceptedById String?         @map("accepted_by_id") @db.Uuid
  expiresAt    DateTime        @map("expires_at")
  acceptedAt   DateTime?       @map("accepted_at")
  createdAt    DateTime        @default(now())

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, email])
  @@index([orgId])
  @@map("invitations")
}

model Integration {
  id           String            @id @default(uuid()) @db.Uuid
  orgId        String            @map("org_id") @db.Uuid
  provider     IntegrationProvider
  name         String
  config       Json
  status       IntegrationStatus @default(DISCONNECTED)
  enabled      Boolean           @default(true)
  lastTestedAt DateTime?         @map("last_tested_at")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("integrations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3: business modules — all tenant-scoped (orgId + RLS). FK columns are
// plain scalars (relationMode = "prisma"); the app resolves names by lookup.
// ─────────────────────────────────────────────────────────────────────────────

// ---- CRM --------------------------------------------------------------------

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  industry  String?
  website   String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@map("companies")
}

model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  companyId  String?  @map("company_id") @db.Uuid
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  email      String?
  phone      String?
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId])
  @@map("contacts")
}

model Lead {
  id        String     @id @default(uuid()) @db.Uuid
  orgId     String     @map("org_id") @db.Uuid
  companyId String?    @map("company_id") @db.Uuid
  contactId String?    @map("contact_id") @db.Uuid
  source    String?
  status    LeadStatus @default(NEW)
  value     Decimal?   @db.Decimal(12, 2)
  ownerId   String?    @map("owner_id") @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([orgId])
  @@map("leads")
}

model Deal {
  id                 String     @id @default(uuid()) @db.Uuid
  orgId              String     @map("org_id") @db.Uuid
  name               String
  companyId          String?    @map("company_id") @db.Uuid
  contactId          String?    @map("contact_id") @db.Uuid
  value              Decimal    @default(0) @db.Decimal(12, 2)
  stage              DealStage  @default(NEW)
  probability        Int        @default(10)
  expectedCloseDate  DateTime?  @map("expected_close_date")
  ownerId            String?    @map("owner_id") @db.Uuid
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([orgId])
  @@map("deals")
}

model Activity {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  userId      String?      @map("user_id") @db.Uuid
  type        ActivityType
  subject     String
  body        String?
  dueAt       DateTime?    @map("due_at")
  completedAt DateTime?    @map("completed_at")
  entityType  String?      @map("entity_type")
  entityId    String?      @map("entity_id") @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId])
  @@map("activities")
}

model Note {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  body       String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now())

  @@index([orgId])
  @@map("notes")
}

// ---- Sales ------------------------------------------------------------------

model Product {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  name         String
  sku          String?
  categoryId   String?  @map("category_id") @db.Uuid
  reorderLevel Int      @default(0) @map("reorder_level")
  price        Decimal  @default(0) @db.Decimal(12, 2)
  cost         Decimal  @default(0) @db.Decimal(12, 2)
  currency     String   @default("USD")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orgId])
  @@map("products")
}

model Quote {
  id          String      @id @default(uuid()) @db.Uuid
  orgId       String      @map("org_id") @db.Uuid
  number      String
  contactId   String?     @map("contact_id") @db.Uuid
  companyId   String?     @map("company_id") @db.Uuid
  status      QuoteStatus @default(DRAFT)
  validUntil  DateTime?   @map("valid_until")
  subtotal    Decimal     @default(0) @db.Decimal(12, 2)
  tax         Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @default(0) @db.Decimal(12, 2)
  issuedById  String?     @map("issued_by_id") @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([orgId, number])
  @@index([orgId])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  quoteId     String   @map("quote_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  description String
  qty         Int      @default(1)
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @default(0) @db.Decimal(12, 2)

  @@index([orgId, quoteId])
  @@map("quote_items")
}

model SalesTarget {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  period    String // YYYY-MM
  amount    Decimal  @default(0) @db.Decimal(12, 2)
  ownerId   String?  @map("owner_id") @db.Uuid
  createdAt DateTime @default(now())

  @@unique([orgId, period])
  @@index([orgId])
  @@map("sales_targets")
}

// ---- Projects ---------------------------------------------------------------

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  orgId       String        @map("org_id") @db.Uuid
  name        String
  description String?
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  budget      Decimal       @default(0) @db.Decimal(12, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([orgId])
  @@map("projects")
}

model ProjectMember {
  id        String @id @default(uuid()) @db.Uuid
  orgId     String @map("org_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  userId    String @map("user_id") @db.Uuid
  role      String @default("member")

  @@unique([projectId, userId])
  @@index([orgId])
  @@map("project_members")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String       @map("org_id") @db.Uuid
  projectId   String?      @map("project_id") @db.Uuid
  milestoneId String?      @map("milestone_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date")
  assigneeId  String?      @map("assignee_id") @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([orgId])
  @@map("tasks")
}

model Milestone {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  title       String
  dueDate     DateTime? @map("due_date")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now())

  @@index([orgId, projectId])
  @@map("milestones")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now())

  @@index([orgId, taskId])
  @@map("task_comments")
}

// ---- Finance ----------------------------------------------------------------

model Account {
  id        String      @id @default(uuid()) @db.Uuid
  orgId     String      @map("org_id") @db.Uuid
  name      String
  type      AccountType
  currency  String      @default("USD")
  createdAt DateTime    @default(now())

  @@index([orgId])
  @@map("accounts")
}

model Transaction {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  accountId   String?  @map("account_id") @db.Uuid
  date        DateTime @default(now())
  amount      Decimal  @db.Decimal(12, 2)
  description String?
  category    String?
  createdAt   DateTime @default(now())

  @@index([orgId])
  @@map("transactions")
}

model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  orgId       String        @map("org_id") @db.Uuid
  number      String
  companyId   String?       @map("company_id") @db.Uuid
  contactId   String?       @map("contact_id") @db.Uuid
  status      InvoiceStatus @default(DRAFT)
  issueDate   DateTime      @default(now()) @map("issue_date")
  dueDate     DateTime?     @map("due_date")
  subtotal    Decimal       @default(0) @db.Decimal(12, 2)
  tax         Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount  Decimal       @default(0) @db.Decimal(12, 2) @map("paid_amount")
  issuedById  String?       @map("issued_by_id") @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([orgId, number])
  @@index([orgId])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  description String
  qty         Int      @default(1)
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @default(0) @db.Decimal(12, 2)

  @@index([orgId, invoiceId])
  @@map("invoice_items")
}

model Payment {
  id        String        @id @default(uuid()) @db.Uuid
  orgId     String        @map("org_id") @db.Uuid
  invoiceId String        @map("invoice_id") @db.Uuid
  date      DateTime      @default(now())
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  createdAt DateTime      @default(now())

  @@index([orgId, invoiceId])
  @@map("payments")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  vendorId    String?  @map("vendor_id") @db.Uuid
  date        DateTime @default(now())
  amount      Decimal  @db.Decimal(12, 2)
  category    String?
  description String?
  createdAt   DateTime @default(now())

  @@index([orgId])
  @@map("expenses")
}

model Vendor {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([orgId])
  @@map("vendors")
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4: ops / support — all tenant-scoped (orgId + RLS).
// ─────────────────────────────────────────────────────────────────────────────

// ---- Inventory ---------------------------------------------------------------

model ProductCategory {
  id       String   @id @default(uuid()) @db.Uuid
  orgId    String   @map("org_id") @db.Uuid
  name     String
  parentId String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now())

  @@index([orgId])
  @@map("product_categories")
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())

  @@index([orgId])
  @@map("suppliers")
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  address   String?
  createdAt DateTime @default(now())

  @@index([orgId])
  @@map("warehouses")
}

model StockLocation {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  name        String
  createdAt   DateTime @default(now())

  @@unique([warehouseId, name])
  @@index([orgId])
  @@map("stock_locations")
}

model StockLevel {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  qty        Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
  @@index([orgId])
  @@map("stock_levels")
}

model StockMovement {
  id          String            @id @default(uuid()) @db.Uuid
  orgId       String            @map("org_id") @db.Uuid
  productId   String            @map("product_id") @db.Uuid
  locationId  String?           @map("location_id") @db.Uuid
  type        StockMovementType
  qty         Int               // always positive; direction is the type
  referenceType String?         @map("reference_type")
  referenceId String?           @map("reference_id") @db.Uuid
  note        String?
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now())

  @@index([orgId, productId])
  @@index([orgId, createdAt])
  @@map("stock_movements")
}

// ---- Support -----------------------------------------------------------------

model Ticket {
  id          String         @id @default(uuid()) @db.Uuid
  orgId       String         @map("org_id") @db.Uuid
  subject      String
  description String?
  customerId  String?        @map("customer_id") @db.Uuid
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  assignedToId String?       @map("assigned_to_id") @db.Uuid
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([orgId])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  ticketId   String   @map("ticket_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  body       String
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([orgId, ticketId])
  @@map("ticket_comments")
}

// ---- Team / HR ---------------------------------------------------------------

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  createdAt DateTime @default(now())

  @@unique([orgId, name])
  @@index([orgId])
  @@map("departments")
}

model Employee {
  id           String         @id @default(uuid()) @db.Uuid
  orgId        String         @map("org_id") @db.Uuid
  userId       String?        @map("user_id") @db.Uuid
  departmentId String?        @map("department_id") @db.Uuid
  firstName    String         @map("first_name")
  lastName     String         @map("last_name")
  title        String?
  email        String?
  phone        String?
  status       EmployeeStatus @default(ACTIVE)
  hireDate     DateTime?      @map("hire_date")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([orgId])
  @@map("employees")
}

// ---- Documents ---------------------------------------------------------------

model DocumentFolder {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now())

  @@index([orgId])
  @@map("document_folders")
}

model Document {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  folderId   String?  @map("folder_id") @db.Uuid
  name       String
  mimeType   String   @map("mime_type")
  size       Int
  storageKey String   @map("storage_key")
  version    Int      @default(1)
  ownerId    String?  @map("owner_id") @db.Uuid
  tags       Json?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([orgId])
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  version     Int
  size        Int
  mimeType    String   @map("mime_type")
  storageKey  String   @map("storage_key")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now())

  @@unique([documentId, version])
  @@index([orgId])
  @@map("document_versions")
}
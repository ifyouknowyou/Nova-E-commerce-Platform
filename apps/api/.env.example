# ────────────────────────────────────────────────────────────────
# NOVA API — environment
# Copy to apps/api/.env. Never commit real secrets.
# ────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://nova:nova_dev_password@localhost:5432/nova_commerce?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change_me_access_secret_openssl_rand_hex_64
JWT_REFRESH_SECRET=change_me_refresh_secret_openssl_rand_hex_64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
JWT_SESSION_TTL=1d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Frontend URLs (for email links)
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# Email (Resend)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=NOVA Commerce <no-reply@nova.local>

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Object storage (S3-compatible — MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nova-media
S3_ACCESS_KEY=nova_minio
S3_SECRET_KEY=nova_minio_password
S3_FORCE_PATH_STYLE=true

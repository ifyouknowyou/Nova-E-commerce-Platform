# ────────────────────────────────────────────────────────────────
# NOVA API (NestJS) — Environment
# Copy to apps/api/.env. Never commit real secrets.
# ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── JWT ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_SESSION_TTL=30d

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated allowed origins.
# Render prod: https://yourdomain.com
CORS_ORIGIN=http://localhost:3000,http://localhost:4000

# ── Public URLs ──────────────────────────────────────────────────
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000/api

# ── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://nova:nova@localhost:5432/nova_commerce

# ── Redis (optional) ─────────────────────────────────────────────
REDIS_URL=

# ── Google OAuth ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Email (Resend) ───────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=NOVA Commerce <no-reply@nova.local>

# ── Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# For single-domain Render deploy:
# STRIPE_WEBHOOK_URL=https://yourdomain.com/api/payments/webhook
STRIPE_WEBHOOK_URL=

# ── Object Storage (S3-compatible) ───────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nova-media
S3_ACCESS_KEY=nova_minio
S3_SECRET_KEY=nova_minio_password
S3_FORCE_PATH_STYLE=true

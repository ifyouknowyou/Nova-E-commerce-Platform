{
  "extends": "@nova/config/tsconfig/tsconfig.base",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2023",
    "outDir": "./dist",
    "baseUrl": "..",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "declaration": false,
    "sourceMap": true,
    "incremental": false,
    "skipLibCheck": true,
    "typeRoots": [
      "node_modules/@types",
      "../../node_modules/@types"
    ],
    "types": ["node", "jest"]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

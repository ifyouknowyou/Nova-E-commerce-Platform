# ────────────────────────────────────────────────────────────────
# NOVA WEB (Next.js) — Environment
# Copy to apps/web/.env.local. Never commit real secrets.
# ────────────────────────────────────────────────────────────────
# Public site URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Database-free, browse-only storefront. Product data and artwork are bundled
# with the app; no API, database, Redis, or external media service is required.
NEXT_PUBLIC_CATALOG_MODE=static

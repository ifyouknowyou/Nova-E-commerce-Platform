# ────────────────────────────────────────────────────────────────
# NOVA WEB (Next.js) — Environment
# Copy to apps/web/.env.local. Never commit real secrets.
# ────────────────────────────────────────────────────────────────
# Public site URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to "static" for a browse-only storefront with bundled products and no database/API.
# Leave unset for the full API-backed commerce experience.
# NEXT_PUBLIC_CATALOG_MODE=static
# Public API base (browser → API).
# For Vercel deployment with Render API: set to "/api" (uses Vercel rewrites).
# For single-domain Render deploy set to "/api".
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Internal API base (server → API, e.g. RSC data fetching).
# For Vercel deployment with Render API set to the Render API URL.
# For single-domain Render deploy set to "http://nova-api:4000".
API_INTERNAL_URL=http://localhost:4000/api
# Stripe publishable key (client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Media host for product/store imagery (S3-compatible). Comma-separate multiple.
# Dev (MinIO): http://localhost:9000
# Prod (S3/Spaces): https://your-bucket.nyc3.digitaloceanspaces.com
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000

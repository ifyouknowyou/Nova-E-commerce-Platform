# ────────────────────────────────────────────────────────────────
# NOVA WEB (Next.js) — environment
# Copy to apps/web/.env.local. Never commit real secrets.
# NEXT_PUBLIC_* values are bundled into the browser bundle.
# ────────────────────────────────────────────────────────────────

# Public site URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public API base (browser→API)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Internal API base (server→API, e.g. RSC data fetching)
API_INTERNAL_URL=http://localhost:4000/api

# Stripe publishable key (client-side)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51U0T03QxrEBgFBCWYz8x85gUDowDGqN0k4CXYVxIImhX6akP6ZbvUUcvHSxNrdOcp2ckMor7XwZO2DvnMDBtQdOQ00sljXT5Wd

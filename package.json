{
  "name": "nova-commerce",
  "version": "1.0.0",
  "private": true,
  "description": "NOVA COMMERCE — multi-vendor enterprise e-commerce platform",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "npm run generate -w @nova/db",
    "db:migrate": "npm run migrate -w @nova/db",
    "build:shared": "npm run build -w @nova/shared",
    "build:web": "npm run build -w @nova/web"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.16.0",
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.1": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  },
  "dependencies": {
    "next": "^16.2.12",
    "react": "^19.2.8"
  }
}

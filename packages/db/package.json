{
  "name": "@nova/db",
  "version": "1.0.0",
  "private": true,
  "description": "Prisma schema, migrations, seed, and generated client for NOVA COMMERCE",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1"
  },
  "devDependencies": {
    "@nova/config": "*",
    "@types/node": "^24.0.0",
    "eslint": "^9.26.0",
    "prisma": "^6.11.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
